# ===== 应用配置 =====
APP_NAME=AI编程实训辅助教学系统
DEBUG=true
# 是否打印 SQL 语句（排查问题时临时打开，平时保持 false）
SQL_ECHO=false

# ===== 数据库配置 =====
DATABASE_URL=sqlite+aiosqlite:///./data/teaching.db

# ===== AI 服务商选择 =====
# 可选：mimo（小米 MiMo）/ deepseek（深度求索）
# 两家都填密钥时，改这一行即可切换，代码无需改动
AI_PROVIDER=deepseek
# 单次请求超时（秒）与失败重试次数（429/5xx/超时自动重试）
AI_TIMEOUT=120
AI_MAX_RETRIES=2

# --- DeepSeek（https://platform.deepseek.com 申请）---
# 可选模型：deepseek-chat（通用）/ deepseek-reasoner（深度思考）
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_API_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# --- 小米 MiMo（OpenAI 兼容格式）---
MIMO_API_KEY=
MIMO_API_URL=https://token-plan-cn.xiaomimimo.com/v1
MIMO_MODEL=mimo-v2.5-pro

# ===== 安全配置 =====
SECRET_KEY=your-secret-key-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ===== 文件上传配置 =====
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# ===== CORS 配置 =====
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# ===== 部署运维（一键更新/回滚）=====
# 是否允许管理后台「部署运维」页面触发更新与回滚；不开也能用命令行 ops 脚本
OPS_ENABLED=false
# systemd 服务名，与 ops/install-service.sh 保持一致
OPS_SERVICE=learning-system
# 发布完成后用于判活的后端地址
OPS_HEALTH_URL=http://127.0.0.1:8000/health
# 项目根目录，留空自动推断
OPS_PROJECT_DIR=
# GitHub webhook 密钥（ops/webhook.py 用，需与 GitHub 上填的一致）
OPS_WEBHOOK_SECRET=
OPS_WEBHOOK_PORT=9100
OPS_BRANCH=main

# ===== 依赖源（发布时 pip / npm 用，国内服务器建议保持镜像）=====
# 改 official 表示使用官方源
PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
NPM_REGISTRY=https://registry.npmmirror.com
# 单步依赖安装超时（秒），超时即判失败，不会无限卡住
INSTALL_TIMEOUT=900
