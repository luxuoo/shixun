# ===== 应用配置 =====
APP_NAME=AI编程实训辅助教学系统
DEBUG=true
# 是否打印 SQL 语句（排查问题时临时打开，平时保持 false）
SQL_ECHO=false

# ===== 数据库配置 =====
DATABASE_URL=sqlite+aiosqlite:///./data/teaching.db

# ===== AI 服务商选择 =====
# 可选：mimo（小米 MiMo）/ deepseek（深度求索）
# 两家都填密钥时，改这一行即可切换，代码无需改动
AI_PROVIDER=deepseek
# 单次请求超时（秒）与失败重试次数（429/5xx/超时自动重试）
AI_TIMEOUT=120
AI_MAX_RETRIES=2

# --- DeepSeek（https://platform.deepseek.com 申请）---
# 可选模型：deepseek-chat（通用）/ deepseek-reasoner（深度思考）
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_API_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# --- 小米 MiMo（OpenAI 兼容格式）---
MIMO_API_KEY=
MIMO_API_URL=https://token-plan-cn.xiaomimimo.com/v1
MIMO_MODEL=mimo-v2.5-pro

# ===== 安全配置 =====
SECRET_KEY=your-secret-key-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ===== 文件上传配置 =====
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# ===== CORS 配置 =====
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
